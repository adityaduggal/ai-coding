# Normalize line endings to LF in the repository, regardless of the
# checkout platform (this repo is developed on Windows but linted/CI'd on
# Linux — see .github/workflows/lint.yml — so a consistent LF history
# avoids markdownlint MD009/MD047 and JSON-parse false diffs from CRLF).
* text=auto eol=lf

*.md text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
